<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

    <!-- TITLE -->
    <div class="col-8 offset-3">
        <h3><%= listing.title %></h3>
    </div>

    <!-- IMAGE CARD -->
    <div class="card col-6 offset-3 listing-card">

        <img
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/600x400' %>"
            class="card-img-top"
            style="height:20rem; object-fit:cover;"
        />

        <div class="card-body">

            <p>
                <b>Owner:</b>
                <%= listing.owner ? listing.owner.username : "Unknown" %>
            </p>

            <p><%= listing.description %></p>

            <p>₹ <%= listing.price || 0 %></p>

            <p><%= listing.location %></p>

            <p><%= listing.country %></p>

        </div>
    </div>

    <!-- EDIT / DELETE -->
    <% if(currentUser && listing.owner && String(listing.owner._id) === String(currentUser._id)) { %>

    <div class="col-8 offset-3 mt-3">

        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">
            Edit
        </a>

        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
            style="display:inline;"
        >
            <button class="btn btn-danger">
                Delete
            </button>
        </form>

    </div>

    <% } %>

    <!-- MAP -->
    <div class="col-8 offset-3 mt-4">

        <h4>Where you'll be</h4>

        <div
            id="map"
            style="height:400px;width:100%;border-radius:10px;"
        ></div>

    </div>

    <!-- REVIEW FORM -->
    <div class="col-8 offset-3 mt-4">

        <hr>

        <h4>Leave a Review</h4>

        <form action="/listings/<%= listing._id %>/reviews" method="POST">

            <fieldset class="starability-slot">

                <input type="radio" id="r5" name="review[rating]" value="5">
                <label for="r5">★</label>

                <input type="radio" id="r4" name="review[rating]" value="4">
                <label for="r4">★</label>

                <input type="radio" id="r3" name="review[rating]" value="3">
                <label for="r3">★</label>

                <input type="radio" id="r2" name="review[rating]" value="2">
                <label for="r2">★</label>

                <input type="radio" id="r1" name="review[rating]" value="1">
                <label for="r1">★</label>

            </fieldset>

            <textarea
                name="review[comment]"
                class="form-control mt-2"
                required
            ></textarea>

            <button class="btn btn-outline-dark mt-2">
                Submit
            </button>

        </form>

        <hr>

        <!-- REVIEWS -->
        <h4>All Reviews</h4>

        <% if(listing.reviews && listing.reviews.length) { %>

            <% for(let review of listing.reviews) { %>

                <div class="card mb-3">
                    <div class="card-body">

                        <b>@<%= review.author ? review.author.username : "user" %></b>

                        <p><%= review.comment %></p>

                        <p>⭐ <%= review.rating %>/5</p>

                    </div>
                </div>

            <% } %>

        <% } else { %>

            <p>No reviews yet.</p>

        <% } %>

    </div>

</div>

<!-- ================= MAP SCRIPT (FINAL FIXED VERSION) ================= -->

<script>
const coords = <%- JSON.stringify(
  listing.geometry && listing.geometry.coordinates
    ? listing.geometry.coordinates
    : []
) %>;

const mapDiv = document.getElementById("map");

if (!coords || coords.length !== 2) {
    mapDiv.innerHTML = "<p class='text-danger'>No location available</p>";
} else {

    const lng = coords[0];
    const lat = coords[1];

    function initMap() {

        const map = L.map("map").setView([lat, lng], 12);

        // FIXED TILE LAYER (stable + no green tiles)
        L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: "&copy; OpenStreetMap contributors"
        }).addTo(map);

        const popupText = `
            <div style="padding:10px;min-width:220px;">
                <h5><%= listing.title %></h5>
                <p>📍 <%= listing.location %>, <%= listing.country %></p>
                <p>₹ <%= listing.price %>/night</p>
                <p>Exact location will be provided after booking</p>
            </div>
        `;

        L.marker([lat, lng])
            .addTo(map)
            .bindPopup(popupText);

        // IMPORTANT: fixes map render issues inside EJS layout
        setTimeout(() => {
            map.invalidateSize();
        }, 100);

    }

    // safe load trigger
    if (document.readyState === "complete") {
        initMap();
    } else {
        window.addEventListener("load", initMap);
    }

}
</script>