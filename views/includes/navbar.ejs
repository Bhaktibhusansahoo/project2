<style>

.navbar{
height:5rem;
background-color:white;
}

.navbar-brand i{
color:#fe424d;
font-size:2rem;
}

/* SEARCH */

.search-form{
display:flex;
justify-content:center;
align-items:center;
flex:1;
}

.search-form form{
display:flex;
align-items:center;
flex-wrap:nowrap;
}

.search-inp{
border-radius:25px;
padding:0.5rem 2rem;
width:20rem;
font-size:1rem;
}

.search-btn{
background-color:#fe424d;
color:white;
border:none;
border-radius:25px;
padding:0.5rem 1rem;
white-space:nowrap;
}

.search-btn:hover{
background-color:#fe424d;
color:white;
}

.search-btn i{
margin-right:0.5rem;
}

</style>



<nav class="navbar navbar-expand-md border-bottom sticky-top">

<div class="container-fluid">

<!-- LOGO -->

<a class="navbar-brand" href="/">

<i class="fa-regular fa-compass"></i>

</a>



<!-- MOBILE BUTTON -->

<button

class="navbar-toggler"

type="button"

data-bs-toggle="collapse"

data-bs-target="#navbarNav"

aria-controls="navbarNav"

aria-expanded="false"

aria-label="Toggle navigation"

>

<span class="navbar-toggler-icon"></span>

</button>



<div class="collapse navbar-collapse" id="navbarNav">

<!-- LEFT -->

<ul class="navbar-nav">

<li class="nav-item">

<a
class="nav-link"
href="/listings">

Explore

</a>

</li>

</ul>



<!-- SEARCH -->

<div class="search-form">

<form role="search">

<input

type="search"

class="form-control search-inp me-2"

placeholder="Search destination"

>

<button

class="btn search-btn"

type="submit">

<i class="fa-solid fa-magnifying-glass"></i>

Search

</button>

</form>

</div>



<!-- RIGHT -->

<div class="navbar-nav ms-auto">

<li class="nav-item">

<a
class="nav-link"
href="/listings/new">

Airbnb your home

</a>

</li>



<% if(!currentUser || currentUser == null){ %>

<li class="nav-item">

<a
class="nav-link"
href="/signup">

<b>Sign Up</b>

</a>

</li>



<li class="nav-item">

<a
class="nav-link"
href="/login">

<b>Log In</b>

</a>

</li>

<% } else { %>

<li class="nav-item">

<a
class="nav-link"
href="#">

Welcome,

<%= currentUser ? currentUser.username : "" %>

</a>

</li>



<li class="nav-item">

<a
class="nav-link"
href="/logout">

<b>Log Out</b>

</a>

</li>

<% } %>

</div>

</div>

</div>

</nav>